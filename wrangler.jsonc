{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schoolsystem33-workers-dev",
  "main": "./worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school33-db",
      "database_id": "1bfe2f67-e4d8-425a-96bf-bbfc294ffbb6"
    }
  ],
  "triggers": {
    "crons": ["0 1 * * *"]
  }
}
